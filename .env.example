# AI Bot Defender — API keys for the LLM Forensics detection engine (auto_query).
#
# Copy this file to `.env` (git-ignored) and fill in the keys you want, OR just
# manage them from the app: LLM Forensics → "Provider API keys" writes this same
# file and applies keys to the running app immediately (no restart).
#
# docker-compose.app.yml passes these variables through, and Docker Compose
# substitutes them from `.env` in the project root on `up`. Leave any you don't
# use blank — the app still boots and demos offline with the mock/* models.

# --- Internal processing (the engine's own GPT-4.1 steps) -------------------
# Powers attribute generation, schema generation, and evidence extraction.
# Without it those steps fall back to deterministic offline heuristics.
OPENAI_API_KEY_INTERNAL=
# Optional: a custom OpenAI-compatible endpoint (Azure / Duke-hosted / etc.).
OPENAI_API_BASE_INTERNAL=

# --- Target chatbots (queried through LiteLLM) ------------------------------
# Each provider is queried live for the models registered in
# auto_query/config/models.py. LiteLLM reads each provider's standard variable.
# The full set of studied chatbots + their key variables is managed from the
# LLM Forensics "Provider API keys" card; fill in only the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY also works for Gemini if you prefer that variable name.
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
PERPLEXITYAI_API_KEY=

# --- Account access --------------------------------------------------------
# Replace both placeholders before exposing the app beyond localhost. Generate
# SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
ADMIN_SECRET=change-me-admin-password

# Public URL placed in approval-email signup links. On the cloud deployment
# this is the admin vhost (https://admin.<base-domain>) and is kept in sync by
# `make set-public-host`; leave as localhost for tunnel-only/local use.
APP_BASE_URL=http://localhost:8000
# External form linked from the app's Request Access page.
GOOGLE_FORM_URL=https://forms.gle/FJV94zCQwi29z36f9

# Gmail address + App Password used for approval/decline notifications. These
# may stay blank during local development; approvals still work and the admin
# console shows the signup URL to share manually.
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Set true only when APP_BASE_URL is HTTPS; this marks the session cookie Secure.
# (Modern browsers still accept Secure cookies over the http://localhost tunnel.)
SESSION_HTTPS_ONLY=false

# Optional organization-wide force for authenticator-app (TOTP) enrollment.
# Leave false for self-service opt-in at /account. Enrolled users are always
# challenged at login regardless of this flag.
REQUIRE_2FA=false

# --- Public identity (cloud deployment) -------------------------------------
# The reverse proxy's public base domain + the raw-IP SAN for the TLS cert,
# consumed by the certgen service in docker-compose.proxy.yml. The same base
# domain drives Grafana's public root URL at https://admin.<base>/grafana/.
# DO NOT edit these by hand: run `make set-public-host` (see
# scripts/set-public-host.sh), which keeps them in sync with all.yml, Grafana,
# the certificate, and every rendered site's nginx block. Blank = defaults.
PROXY_BASE_DOMAIN=
PROXY_EXTRA_SAN=

# --- Monitoring --------------------------------------------------------------
# Grafana's anonymous Viewer surface is protected by the app's admin session at
# /grafana/. This password is still required to sign into Grafana for edits.
# Change it from the default before the first `make monitoring`.
GRAFANA_ADMIN_PASSWORD=

# Safe default: Alertmanager groups alerts and supports silences but sends no
# off-host notification. To enable email/chat/webhook delivery, point this at a
# private Alertmanager YAML file (prefer an absolute path outside the checkout)
# and describe the configured channel in ALERT_DELIVERY_MODE for the admin UI.
ALERTMANAGER_CONFIG=
ALERT_DELIVERY_MODE=local-only
