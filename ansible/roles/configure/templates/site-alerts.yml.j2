# GENERATED BY ANSIBLE — DO NOT EDIT.
# When retiring this site, delete monitoring/alerts.d/{{ site_id }}.yml and
# HUP mon-prometheus; otherwise its absent() alert will fire forever.
groups:
  - name: site-{{ site_id }}
    rules:
      - alert: HoneypotSiteDown
        expr: absent(container_last_seen{name="{{ site_id }}-web-1"})
        for: 5m
        labels:
          severity: critical
          site: "{{ site_id }}"
        annotations:
          summary: "{{ site_id }} web container is gone"
          description: "Visitors get 502 from the proxy; crawlers see a broken site."

      # Generic probe-failed rules only see an existing zero-valued series.
      # These inventory rules also fire if a target file/label disappears.
      - alert: HoneypotSiteProbeMissing
        expr: absent(probe_success{job="public-sites",site="{{ site_id }}",probe_scheme="http",hostname="{{ proxy.server_name | default(site_id ~ '.' ~ proxy.base_domain) }}",instance="http://{{ proxy.server_name | default(site_id ~ '.' ~ proxy.base_domain) }}/"})
        for: 3m
        labels:
          severity: critical
          site: "{{ site_id }}"
          probe_scheme: "http"
        annotations:
          summary: "{{ site_id }} HTTP probe target is missing"
          description: "Prometheus has no HTTP serving-path series for this routed site. Reconcile its generated targets file and Prometheus discovery."

      - alert: HoneypotSiteProbeMissing
        expr: absent(probe_success{job="public-sites",site="{{ site_id }}",probe_scheme="https",hostname="{{ proxy.server_name | default(site_id ~ '.' ~ proxy.base_domain) }}",instance="https://{{ proxy.server_name | default(site_id ~ '.' ~ proxy.base_domain) }}/"})
        for: 3m
        labels:
          severity: critical
          site: "{{ site_id }}"
          probe_scheme: "https"
        annotations:
          summary: "{{ site_id }} HTTPS probe target is missing"
          description: "Prometheus has no HTTPS/TLS serving-path series for this routed site. Reconcile its generated targets file and Prometheus discovery."

{% if database.host is not defined %}
      - alert: HoneypotSiteDbDown
        expr: absent(container_last_seen{name="{{ site_id }}-db-1"})
        for: 5m
        labels:
          severity: warning
          site: "{{ site_id }}"
        annotations:
          summary: "{{ site_id }} database container is gone"
          description: "The site cannot read or persist visits and canary assignments until its Postgres container recovers."
{% endif %}
