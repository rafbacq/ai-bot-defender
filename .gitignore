# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenvs
venv/
.venv/
.venv-app/
env/

# Environment / secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Backup files
*.bak

# Logs
*.log

# Ansible
*.retry

# Claude / MCP tooling (machine-local config; CLAUDE.md itself stays tracked)
.claude/
.mcp.json

# Per-site configuration + apply history (machine-local deployment state, not source)
configs/sites/
configs/history/
# Local authentication database (including SQLite's transient sidecars).
configs/users.db
configs/users.db-journal
configs/users.db-shm
configs/users.db-wal

# Persisted LLM query-run results written by the querying pipeline / web app
querying/runs/

# Training-data provenance + RAG-disambiguation reports (Direction 6b)
querying/provenance/

# Crawler-graph intelligence output: campaigns.json, viz, GNN model, ASN cache
# (Direction 6a, machine-local artifacts; keep the dir via .gitkeep)
crawler_graph/output/*
!crawler_graph/output/.gitkeep

# Self-play output (Direction 2): robust detector, policy, eval report, curve,
# run records, strategy log — machine-local artifacts; keep the dir via .gitkeep.
selfplay/output/*
!selfplay/output/.gitkeep

# Rendered per-site docker-compose output (build artifact)
website/sites/

# Rendered per-site nginx server blocks (Ansible build artifact; keep the dir)
proxy/conf.d/*.conf

# Rendered per-site Prometheus alert rules (Ansible build artifact; keep the dir)
monitoring/alerts.d/*.yml

# Rendered per-site Blackbox file-discovery targets (machine-local hostnames)
monitoring/targets.d/*.yml

# Self-signed TLS certs generated by the certgen init container (keep the dir)
proxy/certs/*
!proxy/certs/.gitkeep


node_modules

# Machine-local build stamps: track when `make app`/`make proxy` last built an
# image so they only rebuild when a build input changed (not on every `up`).
.make/

package.json
package-lock.json
# The app's browser CSS build is intentionally reproducible even though older
# root-level Node manifests remain machine-local.
!frontend/package.json
!frontend/package-lock.json
# Machine-local working notes (personal scratch + live-instance operational
# state; the portable versions live in docs/).
botdefenderjunethirty.txt
EC2_DEPLOYMENT_NOTES.md
CLAUDE.md

# Playwright MCP scratch output (screenshots, snapshots) — never project content.
.playwright-mcp/
